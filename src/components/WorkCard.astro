---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  large?: boolean;
}

const { entry, large = false } = Astro.props;
const { title, summary, company, role, metrics, stack } = entry.data;
---

<a
  href={`/work/${entry.id}`}
  class="group relative flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition duration-300 hover:-translate-y-1 hover:border-accent/60 hover:shadow-[0_18px_40px_-20px_rgb(0_0_0/0.35)] sm:p-7"
>
  <p class="font-mono text-xs text-muted">
    {company} · {role}
  </p>
  <h2
    class:list={[
      'mt-3 font-display font-semibold tracking-tight text-balance',
      large ? 'text-2xl sm:text-3xl' : 'text-xl',
    ]}
    transition:name={`work-title-${entry.id}`}
  >
    {title}
  </h2>
  <p class="mt-3 leading-relaxed text-muted">{summary}</p>

  {metrics.length > 0 && (
    <dl class:list={['mt-6 grid gap-4', large ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-2']}>
      {metrics.slice(0, large ? 4 : 2).map((metric) => (
        <div>
          <dt class="sr-only">{metric.label}</dt>
          <dd class="font-display text-2xl font-semibold tracking-tight">{metric.value}</dd>
          <dd class="text-xs leading-snug text-muted">{metric.label}</dd>
        </div>
      ))}
    </dl>
  )}

  <div class="mt-auto flex items-end justify-between gap-4 pt-6">
    <ul class="flex flex-wrap gap-1.5">
      {stack.slice(0, large ? 6 : 3).map((tech) => (
        <li class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[0.7rem] text-muted">{tech}</li>
      ))}
    </ul>
    <span class="shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
      →
    </span>
  </div>
</a>
