---
// Thin accent bar at the top of the window that fills as you read the page's <article>.
// Driven by updateProgress() in scripts/ui.ts.
---

<div
  data-progress
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 origin-left bg-accent"
  style="transform: scaleX(0)"
></div>
