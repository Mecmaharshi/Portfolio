---
import type { NavLink } from '../lib/nav';
import { site } from '../data/site';
import Logo from './Logo.astro';

interface Props {
  pages: NavLink[];
}

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = Astro.props.pages.filter((item) => item.href !== '/');
---

<header
  data-site-header
  data-no-print
  transition:animate="none"
  class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name}, home`}>
      <Logo class="size-7 transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105" />
      <span class="font-display text-lg font-semibold tracking-tight">
        {site.shortName}
        <span class="text-accent">.</span>
      </span>
    </a>

    <div class="ml-auto flex items-center gap-1 sm:gap-2">
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="flex items-center gap-0.5">
          {links.map((item) => {
            const active = path === item.href || path.startsWith(`${item.href}/`);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class="relative rounded-md px-3 py-2 text-sm text-muted transition-colors after:absolute after:inset-x-3 after:-bottom-[13px] after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-border after:transition-transform after:duration-300 hover:text-text hover:after:scale-x-100 aria-[current=page]:text-text aria-[current=page]:after:hidden"
                >
                  {item.label}
                  {/* Shares a transition name across pages, so it slides to the new link on navigation */}
                  {active && (
                    <span
                      class="absolute inset-x-3 -bottom-[13px] h-0.5 rounded-full bg-accent"
                      transition:name="nav-indicator"
                    />
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <button
        type="button"
        data-palette-open
        class="flex h-9 items-center gap-2 rounded-lg border border-border bg-surface px-2.5 text-sm text-muted transition-colors hover:border-muted/50 hover:text-text"
        aria-label="Open menu and search"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="lg:hidden">Menu</span>
        <span class="hidden lg:inline">Search</span>
        <span class="kbd hidden sm:inline-flex">
          <span data-mod-key>Ctrl</span>&nbsp;K
        </span>
      </button>

      <button
        type="button"
        data-sound-toggle
        aria-pressed="false"
        class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-text"
        aria-label="Sound effects"
        title="Sound effects"
      >
        <svg
          class="size-[18px] sound-on:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
          <path d="m22 9-6 6M16 9l6 6"></path>
        </svg>
        <svg
          class="hidden size-[18px] sound-on:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
          <path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"></path>
        </svg>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-surface-2 hover:text-text"
        aria-label="Toggle light and dark theme"
      >
        <svg
          class="size-[18px] dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          class="hidden size-[18px] dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
