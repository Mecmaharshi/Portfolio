---
import BaseLayout from '../layouts/BaseLayout.astro';

const trace = [
  { hop: 'edge', status: 'hit', ms: '3ms' },
  { hop: 'router', status: 'miss', ms: '1ms' },
  { hop: 'fallback', status: 'none', ms: '0ms' },
];
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="font-mono text-sm text-accent-ink">404 · request failed</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight sm:text-6xl">This route doesn’t resolve.</h1>
    <p class="mt-5 max-w-xl text-lg text-muted">
      I traced the request so you don’t have to. The page may have moved, or the link may have a typo.
    </p>

    <div
      class="mt-10 overflow-x-auto rounded-xl border border-border bg-surface p-5 font-mono text-sm"
      role="img"
      aria-label="Request trace ending in 404 Not Found"
      data-trace
    >
      <p class="trace-line">
        <span class="text-signal">GET</span> <span data-path>/unknown</span>
      </p>
      {trace.map((line) => (
        <p class="trace-line flex gap-4 text-muted">
          <span>├─ {line.hop.padEnd(9, ' ')}</span>
          <span class={line.status === 'hit' ? 'text-ok' : 'text-accent-ink'}>{line.status.padEnd(5, ' ')}</span>
          <span>{line.ms}</span>
        </p>
      ))}
      <p class="trace-line font-semibold text-accent-ink">└─ 404 Not Found</p>
    </div>
    <p class="sr-only" aria-live="polite" data-retry-status></p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/"
        class="btn inline-flex h-11 items-center rounded-lg bg-text px-5 font-medium text-bg transition hover:-translate-y-0.5"
      >
        Back to home
      </a>
      <button
        type="button"
        data-palette-open
        class="inline-flex h-11 items-center gap-3 rounded-lg border border-border bg-surface px-5 font-medium transition hover:-translate-y-0.5"
      >
        Search instead{' '}
        <span class="kbd">
          <span data-mod-key>Ctrl</span>&nbsp;K
        </span>
      </button>
      <!-- A joke for the curious: retries with exponential backoff, then gives up like a good client should -->
      <button
        type="button"
        data-retry
        class="inline-flex h-11 items-center gap-2 rounded-lg px-4 font-mono text-sm text-muted transition-colors hover:text-text disabled:cursor-not-allowed"
      >
        ↻ retry with backoff
      </button>
    </div>
  </section>
</BaseLayout>

<script>
  import { play } from '../scripts/sound';

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector('[data-path]');
    if (el) el.textContent = location.pathname;

    const button = document.querySelector<HTMLButtonElement>('[data-retry]');
    const trace = document.querySelector<HTMLElement>('[data-trace]');
    const status = document.querySelector<HTMLElement>('[data-retry-status]');
    if (!button || !trace || !status) return;

    const line = (html: string) => {
      const p = document.createElement('p');
      p.className = 'retry-line text-muted';
      p.innerHTML = html;
      trace.append(p);
      return p;
    };

    button.addEventListener('click', async () => {
      button.disabled = true;
      // The original last hop is no longer the end of the tree
      const end = [...trace.querySelectorAll('p')].at(-1);
      if (end) end.textContent = end.textContent!.replace('└─', '├─');
      for (const [i, seconds] of [1, 2, 4].entries()) {
        const p = line(`├─ retry ${i + 1}&nbsp;&nbsp;waiting ${seconds}s<span class="dots"></span>`);
        status.textContent = `Retry ${i + 1}, waiting ${seconds} seconds`;
        await wait(seconds * 1000);
        p.innerHTML = `├─ retry ${i + 1}&nbsp;&nbsp;waited ${seconds}s&nbsp;&nbsp;<span class="text-accent-ink">404</span>`;
        play('fail');
      }
      line('<span class="font-semibold text-danger">└─ circuit open: gave up after 3 retries</span>');
      status.textContent = 'Gave up after 3 retries. The page really does not exist.';
      button.textContent = '✕ circuit open';
    });
  });
</script>

<style>
  .trace-line {
    opacity: 0;
    animation: appear 250ms ease-out forwards;
  }
  .trace-line:nth-child(2) {
    animation-delay: 250ms;
  }
  .trace-line:nth-child(3) {
    animation-delay: 500ms;
  }
  .trace-line:nth-child(4) {
    animation-delay: 750ms;
  }
  .trace-line:nth-child(5) {
    animation-delay: 1050ms;
  }
  :global(.retry-line) {
    animation: appear 250ms ease-out both;
  }
  :global(.retry-line .dots)::after {
    content: '';
    animation: dots 1.2s steps(4) infinite;
  }
  @keyframes dots {
    0% {
      content: '';
    }
    25% {
      content: '.';
    }
    50% {
      content: '..';
    }
    75% {
      content: '...';
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
