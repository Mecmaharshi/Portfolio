---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';
import { resumePdf, site, social } from '../data/site';

// Rendered on screen as a page, and printed by scripts/resume-pdf.mjs into the downloadable PDF
const contact = [
  site.location,
  site.email,
  site.url.replace('https://', ''),
  ...social.map((s) => s.href.replace(/^https:\/\/(www\.)?/, '')),
];

// Splits a bullet into text and numbers ("65+", "30,000+", "99.9%", "10–15") so the numbers stand out.
// The lookarounds skip numbers inside names like GPT-4.1, AZ-900 or 3-tier.
const METRIC = /(?<![\w.\-])(\d[\d,.]*(?:–\d+)?(?:M|k)?\+?%?\+?)(?![\w\-])/g;
// Only real measurements count: a +, %, range or thousands separator, or a small count ("8 junior developers").
// That leaves codes like the "504" in "504 failures" alone.
const isMetric = (n: string) => /[+%–,]/.test(n) || n.length <= 2;
const parts = (text: string) =>
  text.split(METRIC).map((part, i) => ({ text: part, metric: i % 2 === 1 && isMetric(part) }));
---

<BaseLayout
  title="Resume"
  og="resume"
  description={`Resume of ${site.name}: ${resume.headline}. 4+ years building production AI systems.`}
>
  <div class="mx-auto max-w-4xl px-4 pt-12 sm:px-6 sm:pt-16 print:max-w-none print:p-0">
    <div class="flex flex-wrap items-center justify-between gap-3" data-no-print>
      <p class="font-mono text-sm text-accent-ink">// resume</p>
      <a
        href={resumePdf}
        download
        data-download
        class="btn inline-flex h-10 items-center gap-2 rounded-lg bg-text px-4 text-sm font-medium text-bg transition hover:-translate-y-0.5"
      >
        <span data-download-label>Download PDF</span>{' '}
        <span class="arrow-down" aria-hidden="true">
          ↓
        </span>
      </a>
    </div>

    <article
      data-reveal-group
      class="resume mt-6 rounded-2xl border border-border bg-surface p-6 sm:p-10 print:mt-0 print:rounded-none print:border-0 print:p-0"
    >
      <header class="border-b border-border pb-6 text-center print:pb-3">
        <h1 class="font-display text-4xl font-semibold tracking-tight print:text-3xl">{site.name}</h1>
        <p class="mt-2 text-lg print:mt-1 print:text-base">{resume.headline}</p>
        <p class="mt-3 text-sm text-muted print:mt-1 print:text-xs">
          {contact.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span class="whitespace-nowrap">{item}</span>
            </>
          ))}
        </p>
      </header>

      <section>
        <h2>Profile</h2>
        <p class="text-muted">{resume.summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {resume.experience.map((job) => (
          <div class="job">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3>
                {job.role}{' '}
                <span class="font-normal text-muted">
                  · {job.company}, {job.location}
                </span>
              </h3>
              <span class="font-mono text-xs text-muted">{job.period}</span>
            </div>
            <ul>
              {job.bullets.map((bullet) => (
                <li>
                  {parts(bullet).map((part) => (part.metric ? <strong class="metric">{part.text}</strong> : part.text))}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Projects</h2>
        {resume.projects.map((project) => (
          <div class="job">
            <h3>
              {project.name} <span class="font-normal text-muted">· {project.role}</span>
            </h3>
            <ul>
              {project.bullets.map((bullet) => (
                <li>
                  {parts(bullet).map((part) => (part.metric ? <strong class="metric">{part.text}</strong> : part.text))}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Skills</h2>
        <ul class="flex flex-wrap gap-1.5 !pl-0">
          {resume.skills.map((skill) => (
            <li class="!m-0 list-none rounded-md bg-surface-2 px-2 py-0.5 font-mono text-xs print:bg-transparent print:p-0 print:after:content-[',_'] print:last:after:content-none">
              {skill}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3>{resume.education.degree}</h3>
          <span class="font-mono text-xs text-muted">{resume.education.period}</span>
        </div>
        <p class="text-muted">
          {resume.education.school} · {resume.education.detail}
        </p>
      </section>

      <section>
        <h2>Certifications</h2>
        <p class="text-muted">{resume.certifications.join(' · ')}</p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .resume section {
    margin-top: 1.75rem;
  }
  .resume h2 {
    margin-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .resume h3 {
    font-weight: 600;
  }
  .resume .job + .job {
    margin-top: 1.1rem;
  }
  .resume ul:not(.flex) {
    margin-top: 0.4rem;
    padding-left: 1.1rem;
    list-style: disc;
  }
  .resume li {
    margin-top: 0.3rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .resume li::marker {
    color: var(--accent);
  }
  /* Numbers read at a glance; hovering a bullet sweeps a highlighter under them */
  .resume .metric {
    font-weight: 600;
    color: var(--text);
    background: linear-gradient(color-mix(in srgb, var(--accent) 25%, transparent) 0 0) 0 90% / 0 40% no-repeat;
    transition: background-size 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .resume li:hover .metric {
    background-size: 100% 40%;
  }

  @media print {
    @page {
      size: A4;
      margin: 10mm 13mm;
    }
    .resume {
      font-size: 9.6pt;
    }
    .resume ul.flex li {
      font-family: var(--font-sans);
      font-size: 9.6pt;
    }
    .resume section {
      margin-top: 0.65rem;
    }
    .resume h2 {
      margin-bottom: 0.3rem;
      color: #111;
    }
    .resume li {
      margin-top: 0.1rem;
      line-height: 1.36;
      color: #222;
    }
    .resume .job + .job {
      margin-top: 0.6rem;
    }
    .resume li::marker {
      color: #111;
    }
    .resume .metric {
      background: none;
      color: #111;
    }
  }
</style>

<script>
  import { toast } from '../scripts/toast';

  document.addEventListener('astro:page-load', () => {
    const link = document.querySelector<HTMLElement>('[data-download]');
    const label = link?.querySelector<HTMLElement>('[data-download-label]');
    if (!link || !label) return;
    link.addEventListener('click', () => {
      label.textContent = 'Downloaded ✓';
      toast('Resume downloading');
      setTimeout(() => (label.textContent = 'Download PDF'), 2500);
    });
  });
</script>
