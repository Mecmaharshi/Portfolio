---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';
import { resumePdf, site, social } from '../data/site';

// Rendered on screen as a page, and printed by scripts/resume-pdf.mjs into the downloadable PDF
const contact = [
  site.location,
  site.email,
  site.url.replace('https://', ''),
  ...social.map((s) => s.href.replace(/^https:\/\/(www\.)?/, '')),
];
---

<BaseLayout
  title="Resume"
  og="resume"
  description={`Resume of ${site.name}: ${resume.headline}. 4+ years building production AI systems.`}
>
  <div class="mx-auto max-w-4xl px-4 pt-12 sm:px-6 sm:pt-16 print:max-w-none print:p-0">
    <div class="flex flex-wrap items-center justify-between gap-3" data-no-print>
      <p class="font-mono text-sm text-accent-ink">// resume</p>
      <a
        href={resumePdf}
        download
        class="inline-flex h-10 items-center gap-2 rounded-lg bg-text px-4 text-sm font-medium text-bg transition hover:-translate-y-0.5"
      >
        Download PDF <span aria-hidden="true">↓</span>
      </a>
    </div>

    <article class="resume mt-6 rounded-2xl border border-border bg-surface p-6 sm:p-10 print:mt-0 print:rounded-none print:border-0 print:p-0">
      <header class="border-b border-border pb-6 text-center print:pb-3">
        <h1 class="font-display text-4xl font-semibold tracking-tight print:text-3xl">{site.name}</h1>
        <p class="mt-2 text-lg print:mt-1 print:text-base">{resume.headline}</p>
        <p class="mt-3 text-sm text-muted print:mt-1 print:text-xs">
          {contact.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <span class="whitespace-nowrap">{item}</span>
            </>
          ))}
        </p>
      </header>

      <section>
        <h2>Profile</h2>
        <p class="text-muted">{resume.summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {resume.experience.map((job) => (
          <div class="job">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3>
                {job.role}{' '}
                <span class="font-normal text-muted">
                  · {job.company}, {job.location}
                </span>
              </h3>
              <span class="font-mono text-xs text-muted">{job.period}</span>
            </div>
            <ul>
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Projects</h2>
        {resume.projects.map((project) => (
          <div class="job">
            <h3>
              {project.name} <span class="font-normal text-muted">· {project.role}</span>
            </h3>
            <ul>
              {project.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Skills</h2>
        <ul class="flex flex-wrap gap-1.5 !pl-0">
          {resume.skills.map((skill) => (
            <li class="!m-0 list-none rounded-md bg-surface-2 px-2 py-0.5 font-mono text-xs print:bg-transparent print:p-0 print:after:content-[',_'] print:last:after:content-none">
              {skill}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3>{resume.education.degree}</h3>
          <span class="font-mono text-xs text-muted">{resume.education.period}</span>
        </div>
        <p class="text-muted">
          {resume.education.school} · {resume.education.detail}
        </p>
      </section>

      <section>
        <h2>Certifications</h2>
        <p class="text-muted">{resume.certifications.join(' · ')}</p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .resume section {
    margin-top: 1.75rem;
  }
  .resume h2 {
    margin-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .resume h3 {
    font-weight: 600;
  }
  .resume .job + .job {
    margin-top: 1.1rem;
  }
  .resume ul:not(.flex) {
    margin-top: 0.4rem;
    padding-left: 1.1rem;
    list-style: disc;
  }
  .resume li {
    margin-top: 0.3rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .resume li::marker {
    color: var(--accent);
  }

  @media print {
    @page {
      size: A4;
      margin: 10mm 13mm;
    }
    .resume {
      font-size: 9.6pt;
    }
    .resume ul.flex li {
      font-family: var(--font-sans);
      font-size: 9.6pt;
    }
    .resume section {
      margin-top: 0.65rem;
    }
    .resume h2 {
      margin-bottom: 0.3rem;
      color: #111;
    }
    .resume li {
      margin-top: 0.1rem;
      line-height: 1.36;
      color: #222;
    }
    .resume .job + .job {
      margin-top: 0.6rem;
    }
    .resume li::marker {
      color: #111;
    }
  }
</style>
