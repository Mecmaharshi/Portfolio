---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, social } from '../../data/site';

const topics = ['Job opportunity', 'Freelance project', 'Just saying hi'];
const field =
  'mt-1.5 w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-base transition-[border-color,box-shadow] duration-200 placeholder:text-muted/70 focus:border-accent focus:shadow-[0_0_0_4px_color-mix(in_srgb,var(--accent)_15%,transparent)] focus:outline-none';
---

<BaseLayout
  title="Contact"
  og="contact"
  description={`Get in touch with ${site.name} about backend and AI engineering roles or freelance projects.`}
>
  <PageHeader eyebrow="// contact" title="Let's build something that doesn't fall over.">
    Hiring for a backend or AI engineering role, or have a project in mind? Send a message below, or email me at{' '}
    <a class="ulink text-accent-ink" href={`mailto:${site.email}`}>
      {site.email}
    </a>
  </PageHeader>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_320px]" data-reveal-group>
    <div class="relative rounded-2xl border border-border bg-surface p-6 sm:p-8">
      <!-- Netlify detects this form at deploy time; data-astro-reload stops client-side routing from intercepting it.
           novalidate: the script validates instead, so invalid fields can shake rather than just show a bubble -->
      <form
        name="contact"
        method="POST"
        action="/contact/thanks"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-astro-reload
        data-contact-form
        novalidate
        class="grid gap-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>
            Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <fieldset>
          <legend class="text-sm font-medium">What's this about?</legend>
          <!-- The dark pill slides behind whichever topic is selected (see script) -->
          <div class="group relative mt-2 flex flex-wrap gap-2" data-topics>
            <span
              class="absolute rounded-full bg-text opacity-0 transition-all duration-300 ease-out"
              data-topic-pill
              aria-hidden="true"
            ></span>
            {topics.map((topic, i) => (
              <label class="relative cursor-pointer">
                <input type="radio" name="topic" value={topic} checked={i === 0} class="peer sr-only" />
                <span class="inline-flex rounded-full border border-border px-3.5 py-1.5 text-sm text-muted transition-colors duration-300 peer-checked:border-text peer-checked:bg-text peer-checked:text-bg peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent group-data-ready:peer-checked:bg-transparent hover:text-text">
                  {topic}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium">
            Name
            <input class={field} type="text" name="name" required autocomplete="name" placeholder="Ada Lovelace" />
          </label>
          <label class="block text-sm font-medium">
            Email
            <input
              class={field}
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="ada@company.com"
            />
          </label>
        </div>

        <label class="block text-sm font-medium">
          Message
          <textarea
            class={`${field} min-h-36 resize-y`}
            name="message"
            required
            placeholder="What are you building, and where could I help?"
          ></textarea>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            data-send
            class="send relative inline-flex h-11 items-center gap-2 overflow-hidden rounded-lg bg-text px-5 font-medium text-bg transition hover:-translate-y-0.5 disabled:translate-y-0 disabled:opacity-80"
          >
            <span data-send-label>Send message</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </button>
          <p class="text-sm text-danger" data-form-error hidden>
            That didn't go through. Please email me at{' '}
            <a class="underline" href={`mailto:${site.email}`}>
              {site.email}
            </a>
            .
          </p>
        </div>
      </form>

      <!-- Success state: a little request trace, then a thank-you -->
      <div class="hidden" data-form-success aria-live="polite">
        <div class="rounded-xl border border-border bg-bg p-5 font-mono text-sm">
          <p class="sent-line">
            <span class="text-signal">POST</span> /contact
          </p>
          <p class="sent-line text-muted">
            ├─ validate&nbsp;&nbsp;<span class="text-ok">ok</span>
          </p>
          <p class="sent-line text-muted">
            ├─ deliver&nbsp;&nbsp;&nbsp;<span class="text-ok">ok</span>
          </p>
          <p class="sent-line font-semibold text-ok">└─ 200 message delivered</p>
        </div>
        <h2 class="mt-6 font-display text-2xl font-semibold">Thanks, message received.</h2>
        <p class="mt-2 text-muted">I read everything that comes through here and will reply by email.</p>
      </div>
    </div>

    <aside class="space-y-6 text-sm">
      <div>
        <h2 class="font-mono text-xs tracking-wider text-muted uppercase">Email</h2>
        <a class="ulink mt-1 inline-block text-base font-medium" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </div>
      <div>
        <h2 class="font-mono text-xs tracking-wider text-muted uppercase">Based in</h2>
        <p class="mt-1 text-base">{site.location}</p>
      </div>
      <div>
        <h2 class="font-mono text-xs tracking-wider text-muted uppercase">Elsewhere</h2>
        <ul class="mt-1 space-y-1 text-base">
          {social.map((link) => (
            <li>
              <a class="transition-colors hover:text-accent-ink" href={link.href} target="_blank" rel="noopener">
                {link.label}{' '}
                <span class="arrow-ne" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import { play } from '../../scripts/sound';

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form) return;
    const error = document.querySelector<HTMLElement>('[data-form-error]')!;
    const success = document.querySelector<HTMLElement>('[data-form-success]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-send]')!;
    const label = form.querySelector<HTMLElement>('[data-send-label]')!;

    // Sliding pill behind the selected topic
    const topics = form.querySelector<HTMLElement>('[data-topics]')!;
    const pill = form.querySelector<HTMLElement>('[data-topic-pill]')!;
    const movePill = () => {
      const chip = topics.querySelector<HTMLElement>('input:checked + span');
      if (!chip) return;
      Object.assign(pill.style, {
        left: `${chip.offsetLeft}px`,
        top: `${chip.offsetTop}px`,
        width: `${chip.offsetWidth}px`,
        height: `${chip.offsetHeight}px`,
        opacity: '1',
      });
      topics.dataset.ready = '';
    };
    movePill();
    topics.addEventListener('change', movePill);
    addEventListener('resize', movePill);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;

      const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')].filter(
        (el) => !el.checkValidity(),
      );
      if (invalid.length) {
        invalid.forEach((el) => {
          el.classList.remove('shake');
          void el.offsetWidth;
          el.classList.add('shake');
        });
        invalid[0].reportValidity();
        play('error');
        return;
      }

      button.disabled = true;
      button.classList.add('sending');
      label.textContent = 'Sending…';
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('hidden');
        success.classList.remove('hidden');
        play('chime');
      } catch {
        error.hidden = false;
        button.disabled = false;
        play('error');
      } finally {
        button.classList.remove('sending');
        label.textContent = 'Send message';
      }
    });
  });
</script>

<style>
  /* While sending, a packet travels across the button */
  .send.sending::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -12px;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 30%, transparent);
    animation: packet 900ms cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes packet {
    to {
      left: calc(100% + 12px);
    }
  }
  .sent-line {
    opacity: 0;
    animation: appear 250ms ease-out forwards;
  }
  .sent-line:nth-child(2) {
    animation-delay: 250ms;
  }
  .sent-line:nth-child(3) {
    animation-delay: 500ms;
  }
  .sent-line:nth-child(4) {
    animation-delay: 800ms;
  }
  @keyframes appear {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
