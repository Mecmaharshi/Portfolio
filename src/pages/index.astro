---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

// `to` drives the count-up animation; `value` is the final text everyone ends up seeing.
const stats = [
  { value: '1M+', to: 1_000_000, label: 'data requests a day through FastAPI services on Azure Functions' },
  { value: '30k+', to: 30_000, label: 'financial documents processed monthly at 99.9% uptime' },
  { value: '65+', to: 65, label: 'Durable Functions orchestrating 6 AI services in production' },
  { value: '20%+', to: 20, label: 'fewer creative regenerations with LLM-as-judge scoring' },
];
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div
      class="bg-dots pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_30%_20%,black,transparent_70%)]"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-6xl px-4 pt-20 pb-16 sm:px-6 sm:pt-28 md:pb-24">
      <p class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-sm text-muted">
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-ok"></span>
        </span>
        Currently at {site.current.company}, {site.current.doing}
      </p>

      <h1 class="mt-7 max-w-4xl font-display text-[2.6rem] leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl md:text-7xl">
        I build production AI systems that{' '}
        <span class="relative inline-block whitespace-nowrap text-accent-ink">
          don’t fall over
          <svg
            class="squiggle absolute -bottom-2 left-0 h-3 w-full text-accent"
            viewBox="0 0 300 12"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M2 8 C 40 2, 70 12, 110 6 S 180 2, 220 7 S 280 10, 298 4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              pathLength="1"
            ></path>
          </svg>
        </span>
        .
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        I’m {site.shortName}, a backend engineer with 4+ years designing LLM pipelines, RAG and agentic systems, and
        event-driven serverless backends on Azure. Currently at Dentsu; previously at Celebal Technologies.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex h-11 items-center gap-2 rounded-lg bg-text px-5 font-medium text-bg transition hover:-translate-y-0.5 hover:shadow-lg"
        >
          Email me
          <span aria-hidden="true">→</span>
        </a>
        <button
          type="button"
          data-palette-open
          class="inline-flex h-11 items-center gap-3 rounded-lg border border-border bg-surface px-5 font-medium transition hover:-translate-y-0.5 hover:border-muted/50"
        >
          Explore the site
          <span class="kbd">
            <span data-mod-key>Ctrl</span>&nbsp;K
          </span>
        </button>
      </div>
      <p class="mt-5 text-sm text-muted">Open to senior backend and AI engineering roles, and to freelance projects.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-labelledby="numbers">
    <h2 id="numbers" class="font-mono text-sm text-muted">
      // by the numbers
    </h2>
    <dl class="mt-5 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="flex flex-col gap-2 bg-surface p-6">
          <dt class="order-2 text-sm leading-snug text-muted">{stat.label}</dt>
          <dd class="order-1 font-display text-4xl font-semibold tracking-tight">
            <span class="sr-only">{stat.value}</span>
            <span aria-hidden="true" data-count-to={stat.to}>
              {stat.value}
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>

<style>
  /* Hidden until the draw starts: a zero-length dash would otherwise show its round cap as a dot */
  .squiggle path {
    stroke-dasharray: 1;
    animation: draw 900ms 400ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
