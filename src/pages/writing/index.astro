---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../../lib/content';

const posts = await getPosts();
---

<!-- Not linked anywhere until the first post is published (see lib/nav.ts) -->
<BaseLayout
  title="Writing"
  og="writing"
  description="Notes on building production AI systems: LLM pipelines, RAG, reliability and the parts around the model."
  noindex={posts.length === 0}
>
  <PageHeader eyebrow="// writing" title="Notes from production.">
    The hard parts of building AI systems that real people depend on, written up while they're still fresh.
  </PageHeader>

  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    {posts.length === 0 ? (
      <p class="text-muted">The first post is on its way.</p>
    ) : (
      <ul class="divide-y divide-border border-y border-border" data-reveal-group>
        {posts.map((post) => (
          <li>
            <a
              href={`/writing/${post.id}`}
              class="group grid gap-2 py-6 transition-[padding] duration-300 hover:pl-2 sm:grid-cols-[140px_1fr_auto] sm:items-baseline sm:gap-6"
            >
              <time class="font-mono text-sm text-muted" datetime={post.data.published.toISOString()}>
                {formatDate(post.data.published)}
              </time>
              <div>
                <h2 class="font-display text-xl font-semibold tracking-tight transition-colors group-hover:text-accent-ink sm:text-2xl">
                  {post.data.title}
                  {post.data.draft && <span class="ml-2 align-middle font-mono text-xs text-danger">draft</span>}
                </h2>
                <p class="mt-1 text-muted">{post.data.description}</p>
              </div>
              <span
                class="hidden text-accent transition-transform group-hover:translate-x-1 sm:block"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
